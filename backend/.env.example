# EduGenesis API Configuration Example (讯飞星火大模型专用配置)
# Copy this file to '.env' and fill in your actual APIPassword

# 讯飞星火大模型 OpenAI 兼容接口配置
LLM_API_KEY=your-APIPassword-here
LLM_API_BASE=https://spark-api-open.xf-yun.com/v1

# 讯飞星火模型版本号选项:
# - generalv3.5 (星火 V3.5 Pro - 推荐)
# - 4.0Ultra (星火 V4.0 Ultra - 旗舰版)
# - general (星火 Lite - 免费且响应快，适合开发调试)
LLM_MODEL=generalv3.5
